---
import Head from "@components/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import { SITE } from "@consts";

type Props = {
  title: string;
  description: string;
  image?: string;
  titleTemplate?: boolean;
};

const { title, description, image, titleTemplate = true } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Head
      title={titleTemplate ? `${title} | ${SITE.NAME}` : title}
      description={description}
      image={image}
    />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
