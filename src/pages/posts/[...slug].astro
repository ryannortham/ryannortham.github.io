---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BackToPrev from "@components/BackToPrev.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { readingTime } from "@lib/utils";
import PageLayout from "@layouts/PageLayout.astro";

export async function getStaticPaths() {
  const posts = (await getCollection("posts")).filter((post) => !post.data.draft);
  return posts.map((post) => ({
    params: {
      slug: post.id.replace(/\.(md|mdx)$/, "").replace(/\/index$/, ""),
    },
    props: post,
  }));
}

type Props = CollectionEntry<"posts">;

const post = Astro.props;
const { Content } = await render(post);
---

<PageLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.image}
>
  <Container>
    <div class="animate">
      <BackToPrev href="/blog/">Back to blog</BackToPrev>
    </div>
    <header class="my-10 space-y-2">
      <div class="animate flex items-center gap-1.5 text-sm">
        <FormattedDate date={post.data.date} />
        <span aria-hidden="true">&bull;</span>
        <span>{readingTime(post.body ?? "")}</span>
      </div>
      <h1 class="animate text-3xl font-semibold leading-tight text-black dark:text-white">
        {post.data.title}
      </h1>
    </header>
    <article class="animate">
      <Content />
    </article>
  </Container>
</PageLayout>
