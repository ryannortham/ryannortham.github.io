---
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
---

<PageLayout title="Hermes Calendar terms of use" description="Terms for the private Hermes Calendar connection.">
  <Container>
    <article>
      <h1>Hermes Calendar terms of use</h1>
      <p>Effective 29 September 2026. Hermes Calendar is a private connection operated by Ryan Northam for Google accounts he authorizes. It is not offered as a public service.</p>
      <p>Use requires the account holder's Google OAuth consent. The account holder may revoke that consent through their Google Account at any time. The connection is provided as is, without a service availability commitment.</p>
      <p>Questions? Email <a href="mailto:ryan.northam@gmail.com">ryan.northam@gmail.com</a>.</p>
      <p><a href="/hermes-calendar/">About Hermes Calendar</a> · <a href="/hermes-calendar/privacy/">Privacy policy</a></p>
    </article>
  </Container>
</PageLayout>
