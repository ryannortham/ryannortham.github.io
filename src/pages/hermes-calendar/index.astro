---
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
---

<PageLayout title="Hermes Calendar" description="A private Google Calendar connection operated by Ryan Northam.">
  <Container>
    <article>
      <h1>Hermes Calendar</h1>
      <p>Hermes Calendar is a private Google Calendar connection operated by Ryan Northam. It lets my personal assistant read calendar events I authorize and create or update events in my personal calendar when I ask.</p>
      <p>Only Google accounts I authorize can use this connection. There is no public sign-up.</p>
      <p>Read the <a href="/hermes-calendar/privacy/">privacy policy</a> and <a href="/hermes-calendar/terms/">terms of use</a>.</p>
      <p>Questions? Email <a href="mailto:ryan.northam@gmail.com">ryan.northam@gmail.com</a>.</p>
    </article>
  </Container>
</PageLayout>
