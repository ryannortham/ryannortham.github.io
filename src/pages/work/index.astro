---
import { getCollection, render } from "astro:content";
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import { WORK } from "@consts";
import PageLayout from "@layouts/PageLayout.astro";
import { dateRange } from "@lib/utils";

const entries = (await getCollection("work")).sort(
  (a, b) =>
    (b.data.dateStart?.valueOf() ?? Number.MAX_SAFE_INTEGER) -
    (a.data.dateStart?.valueOf() ?? Number.MAX_SAFE_INTEGER),
);

const work = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await render(entry);
    return { ...entry, Content };
  }),
);

const companies = work.reduce<Array<typeof work>>((groups, entry) => {
  const group = groups.find(
    (items) => items[0]?.data.company === entry.data.company,
  );
  if (group) group.push(entry);
  else groups.push([entry]);
  return groups;
}, []);
---

<PageLayout title={WORK.TITLE} description={WORK.DESCRIPTION}>
  <Container>
    <div class="space-y-10">
      <h1 class="animate text-3xl font-semibold leading-tight text-ink-strong dark:text-white">Work</h1>
      <div class="space-y-12">
        {companies.map((roles) => (
          <section class="animate">
            <h2 class="text-xl font-semibold text-ink-strong dark:text-white">
              {roles[0].data.companyURL ? (
                <Link href={roles[0].data.companyURL} external>
                  {roles[0].data.company}
                </Link>
              ) : roles[0].data.company}
            </h2>
            <div class="text-sm opacity-75">
              {[roles[0].data.employmentType, roles[0].data.location]
                .filter(Boolean)
                .join(" · ")}
            </div>

            <ul class="mt-7 space-y-12 border-l border-ink/20 dark:border-white/20">
              {roles.map((entry) => (
                <li class="relative pl-6">
                  <span
                    class="absolute -left-1 top-2 size-2 rounded-full bg-ink/40 dark:bg-stone-500"
                    aria-hidden="true"
                  ></span>
                  <h3 class="font-semibold text-ink-strong dark:text-white">
                    {entry.data.role}
                  </h3>
                  <div class="text-sm opacity-75">
                    {dateRange(entry.data.dateStart, entry.data.dateEnd)}
                  </div>
                  <article class="mt-4"><entry.Content /></article>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </div>
  </Container>
</PageLayout>
