---
type Props = {
  href: string;
  external?: boolean;
  underline?: boolean;
}

const { href, external, underline = true, ...rest } = Astro.props;
---

<a 
  href={href} 
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  class:list={[
    "inline-block decoration-ink/25 dark:decoration-white/30 hover:decoration-ink/45 hover:dark:decoration-white/50 text-current hover:text-ink-strong hover:dark:text-white transition-colors duration-300 ease-in-out",
    { "underline underline-offset-2": underline },
  ]}
  {...rest}>
  <slot/>
</a>
